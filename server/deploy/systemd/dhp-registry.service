[Unit]
Description=DHP Registry Server
After=network.target

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/data/app/halo-digital
ExecStart=/data/app/halo-digital/dhp-registry --config /data/app/halo-digital/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
ProtectSystem=strict
ReadWritePaths=/data/app/halo-digital/halo-data
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
